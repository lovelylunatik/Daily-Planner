  <div class="nebula absolute w-[40vw] h-[40vw] rounded-full opacity-20 dark:opacity-20 opacity-5" style="top:50%;left:60%;background:radial-gradient(circle,var(--rose-soft) 0%,transparent 70%);animation:drift 30s ease-in-out 5s infinite reverse;"></div>
</div>

