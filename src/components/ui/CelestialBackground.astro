---
---
<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <!-- Deep nebula base layer -->
  <div class="nebula-base absolute inset-0"></div>
  
  <!-- Rich star field with twinkling layers -->
  <div class="star-layer star-layer-1 absolute inset-0"></div>
  <div class="star-layer star-layer-2 absolute inset-0"></div>
  <div class="star-layer star-layer-3 absolute inset-0"></div>
  
  <!-- Constellation lines -->
  <svg class="constellation-lines absolute inset-0 w-full h-full" preserveAspectRatio="none">
    <line x1="12%" y1="15%" x2="22%" y2="22%" stroke="rgba(201,169,110,0.08)" stroke-width="0.5"/>
    <line x1="22%" y1="22%" x2="30%" y2="18%" stroke="rgba(201,169,110,0.06)" stroke-width="0.5"/>
    <line x1="30%" y1="18%" x2="35%" y2="28%" stroke="rgba(201,169,110,0.05)" stroke-width="0.5"/>
    <line x1="65%" y1="12%" x2="72%" y2="18%" stroke="rgba(201,169,110,0.07)" stroke-width="0.5"/>
    <line x1="72%" y1="18%" x2="80%" y2="14%" stroke="rgba(201,169,110,0.06)" stroke-width="0.5"/>
    <line x1="80%" y1="14%" x2="85%" y2="22%" stroke="rgba(201,169,110,0.05)" stroke-width="0.5"/>
    <line x1="15%" y1="65%" x2="25%" y2="72%" stroke="rgba(140,170,120,0.06)" stroke-width="0.5"/>
    <line x1="70%" y1="60%" x2="78%" y2="68%" stroke="rgba(168,149,182,0.05)" stroke-width="0.5"/>
    <line x1="78%" y1="68%" x2="85%" y2="62%" stroke="rgba(168,149,182,0.04)" stroke-width="0.5"/>
    <line x1="40%" y1="50%" x2="48%" y2="45%" stroke="rgba(201,169,110,0.04)" stroke-width="0.5"/>
    <line x1="48%" y1="45%" x2="55%" y2="52%" stroke="rgba(201,169,110,0.03)" stroke-width="0.5"/>
  </svg>
  
  <!-- Drifting luminous orbs -->
  <div class="orb orb-1 absolute rounded-full" style="top:8%;left:15%;width:200px;height:200px;background:radial-gradient(circle, rgba(201,169,110,0.12) 0%, rgba(201,169,110,0.05) 30%, transparent 70%);"></div>
  <div class="orb orb-2 absolute rounded-full" style="top:55%;left:72%;width:280px;height:280px;background:radial-gradient(circle, rgba(176,112,120,0.08) 0%, rgba(176,112,120,0.03) 30%, transparent 70%);"></div>
  <div class="orb orb-3 absolute rounded-full" style="top:70%;left:8%;width:160px;height:160px;background:radial-gradient(circle, rgba(168,149,182,0.1) 0%, rgba(168,149,182,0.04) 30%, transparent 70%);"></div>
  <div class="orb orb-4 absolute rounded-full" style="top:20%;left:60%;width:180px;height:180px;background:radial-gradient(circle, rgba(140,170,120,0.06) 0%, transparent 70%);"></div>
  <div class="orb orb-5 absolute rounded-full" style="top:80%;left:45%;width:220px;height:220px;background:radial-gradient(circle, rgba(201,169,110,0.07) 0%, transparent 70%);"></div>
  
  <!-- Shooting star -->
  <div class="shooting-star absolute" style="top:20%;left:80%;width:60px;height:1px;background:linear-gradient(to right, transparent, rgba(255,255,255,0.4), transparent);"></div>
</div>

<style>
  @keyframes twinkle {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }
  @keyframes drift {
    0% { transform: translate(0, 0); }
    25% { transform: translate(12px, -8px); }
    50% { transform: translate(20px, 4px); }
    75% { transform: translate(8px, 12px); }
    100% { transform: translate(0, 0); }
  }
  @keyframes drift-reverse {
    0% { transform: translate(0, 0); }
    33% { transform: translate(-15px, 10px); }
    66% { transform: translate(-8px, -12px); }
    100% { transform: translate(0, 0); }
  }
  @keyframes shoot {
    0% { transform: translateX(0) translateY(0) rotate(-25deg); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateX(-300px) translateY(150px) rotate(-25deg); opacity: 0; }
  }
  
  :global(html.dark) .nebula-base {
    background:
      radial-gradient(ellipse at 50% 20%, rgba(201,169,110,0.04) 0%, transparent 50%),
      radial-gradient(ellipse at 20% 80%, rgba(140,170,120,0.025) 0%, transparent 40%),
      radial-gradient(ellipse at 80% 70%, rgba(176,112,120,0.02) 0%, transparent 35%),
      radial-gradient(ellipse at 40% 60%, rgba(168,149,182,0.015) 0%, transparent 45%),
      linear-gradient(180deg, #080c18 0%, #0c1220 30%, #0a0f1c 60%, #0c1425 100%);
  }
  :global(html.light) .nebula-base {
    background: transparent;
  }
  /* Default for no-js */
  .nebula-base {
    background:
      radial-gradient(ellipse at 50% 20%, rgba(201,169,110,0.04) 0%, transparent 50%),
      radial-gradient(ellipse at 20% 80%, rgba(140,170,120,0.025) 0%, transparent 40%),
      radial-gradient(ellipse at 80% 70%, rgba(176,112,120,0.02) 0%, transparent 35%),
      radial-gradient(ellipse at 40% 60%, rgba(168,149,182,0.015) 0%, transparent 45%),
      linear-gradient(180deg, #080c18 0%, #0c1220 30%, #0a0f1c 60%, #0c1425 100%);
  }
  
  .star-layer {
    background-size: 200px 200px, 300px 300px, 250px 250px;
    background-blend-mode: screen;
  }
  
  .star-layer-1 {
    background-image:
      radial-gradient(1.2px 1.2px at 15% 12%, rgba(240,230,210,0.8), transparent),
      radial-gradient(1px 1px at 35% 8%, rgba(201,169,110,0.6), transparent),
      radial-gradient(1.5px 1.5px at 55% 18%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 72% 5%, rgba(240,230,210,0.7), transparent),
      radial-gradient(1.2px 1.2px at 88% 22%, rgba(201,169,110,0.5), transparent),
      radial-gradient(1px 1px at 5% 35%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1.5px 1.5px at 25% 42%, rgba(240,230,210,0.6), transparent),
      radial-gradient(1px 1px at 45% 32%, rgba(201,169,110,0.5), transparent),
      radial-gradient(1.2px 1.2px at 62% 48%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 82% 38%, rgba(240,230,210,0.5), transparent),
      radial-gradient(1.5px 1.5px at 8% 65%, rgba(201,169,110,0.6), transparent),
      radial-gradient(1px 1px at 28% 72%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1.2px 1.2px at 48% 62%, rgba(240,230,210,0.5), transparent),
      radial-gradient(1px 1px at 68% 78%, rgba(201,169,110,0.4), transparent),
      radial-gradient(1.5px 1.5px at 85% 68%, rgba(255,255,255,0.6), transparent),
      radial-gradient(1px 1px at 12% 88%, rgba(240,230,210,0.5), transparent),
      radial-gradient(1.2px 1.2px at 32% 92%, rgba(201,169,110,0.4), transparent),
      radial-gradient(1px 1px at 52% 85%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1.5px 1.5px at 72% 95%, rgba(240,230,210,0.4), transparent),
      radial-gradient(1px 1px at 92% 82%, rgba(201,169,110,0.5), transparent);
    animation: twinkle 5s ease-in-out infinite alternate;
  }
  
  .star-layer-2 {
    background-image:
      radial-gradient(1px 1px at 10% 20%, var(--gold-dim), transparent),
      radial-gradient(1.2px 1.2px at 30% 15%, rgba(168,149,182,0.15), transparent),
      radial-gradient(1px 1px at 50% 25%, var(--gold-dim), transparent),
      radial-gradient(1.5px 1.5px at 70% 10%, rgba(140,170,120,0.12), transparent),
      radial-gradient(1px 1px at 90% 30%, var(--gold-dim), transparent),
      radial-gradient(1.2px 1.2px at 20% 50%, rgba(168,149,182,0.1), transparent),
      radial-gradient(1px 1px at 40% 55%, var(--gold-dim), transparent),
      radial-gradient(1.5px 1.5px at 60% 45%, rgba(140,170,120,0.12), transparent),
      radial-gradient(1px 1px at 80% 60%, var(--gold-dim), transparent),
      radial-gradient(1.2px 1.2px at 95% 50%, rgba(168,149,182,0.1), transparent),
      radial-gradient(1px 1px at 15% 75%, var(--gold-dim), transparent),
      radial-gradient(1.5px 1.5px at 35% 80%, rgba(140,170,120,0.12), transparent),
      radial-gradient(1px 1px at 55% 70%, var(--gold-dim), transparent),
      radial-gradient(1.2px 1.2px at 75% 85%, rgba(168,149,182,0.1), transparent),
      radial-gradient(1px 1px at 88% 75%, var(--gold-dim), transparent);
    animation: twinkle 7s ease-in-out 1.5s infinite alternate;
  }
  
  .star-layer-3 {
    background-image:
      radial-gradient(0.8px 0.8px at 18% 18%, rgba(255,255,255,0.3), transparent),
      radial-gradient(0.8px 0.8px at 38% 28%, rgba(255,255,255,0.25), transparent),
      radial-gradient(0.8px 0.8px at 58% 12%, rgba(255,255,255,0.3), transparent),
      radial-gradient(0.8px 0.8px at 78% 35%, rgba(255,255,255,0.2), transparent),
      radial-gradient(0.8px 0.8px at 8% 55%, rgba(255,255,255,0.25), transparent),
      radial-gradient(0.8px 0.8px at 28% 62%, rgba(255,255,255,0.3), transparent),
      radial-gradient(0.8px 0.8px at 48% 75%, rgba(255,255,255,0.2), transparent),
      radial-gradient(0.8px 0.8px at 68% 82%, rgba(255,255,255,0.25), transparent),
      radial-gradient(0.8px 0.8px at 88% 68%, rgba(255,255,255,0.3), transparent),
      radial-gradient(0.8px 0.8px at 12% 90%, rgba(255,255,255,0.2), transparent),
      radial-gradient(0.8px 0.8px at 42% 92%, rgba(255,255,255,0.25), transparent),
      radial-gradient(0.8px 0.8px at 72% 92%, rgba(255,255,255,0.2), transparent);
    animation: twinkle 4s ease-in-out 0.5s infinite alternate;
  }
  
  .orb-1 { animation: drift 28s ease-in-out infinite; }
  .orb-2 { animation: drift-reverse 35s ease-in-out 4s infinite; }
  .orb-3 { animation: drift 32s ease-in-out 8s infinite; }
  .orb-4 { animation: drift-reverse 26s ease-in-out 2s infinite; }
  .orb-5 { animation: drift 30s ease-in-out 6s infinite; }
  
  .shooting-star {
    animation: shoot 8s ease-out infinite;
    animation-delay: 3s;
  }
  
  .constellation-lines { opacity: 0.4; }
</style>