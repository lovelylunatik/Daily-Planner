---
// Floating background decorations — moons, cherubs, butterflies, stars
// Pure CSS/SVG whimsy for empty space around Hub panes
---

<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <!-- Glowing orbs / nebulae -->
  <div class="absolute rounded-full" style="top:12%;left:8%;width:180px;height:180px;background:radial-gradient(circle, rgba(201,169,110,0.35) 0%, transparent 70%);opacity:0.08;animation: drift 28s ease-in-out infinite;"></div>
  <div class="absolute rounded-full" style="top:55%;left:75%;width:220px;height:220px;background:radial-gradient(circle, rgba(176,112,120,0.25) 0%, transparent 70%);opacity:0.06;animation: drift 35s ease-in-out 4s infinite reverse;"></div>
  <div class="absolute rounded-full" style="top:78%;left:15%;width:140px;height:140px;background:radial-gradient(circle, rgba(168,149,182,0.25) 0%, transparent 70%);opacity:0.08;animation: drift 32s ease-in-out 8s infinite;"></div>

  <!-- Crescent moon with face -->
  <div class="absolute" style="top:8%;right:12%;opacity:0.5;transform:rotate(-15deg);">
    <div class="crescent-moon">
      <span class="moon-face">◡</span>
    </div>
  </div>

  <!-- Small cherub silhouette -->
  <div class="absolute" style="top:20%;left:30%;opacity:0.35;transform:scale(0.7);animation: drift 24s ease-in-out infinite;">
    <svg width="40" height="50" viewBox="0 0 40 50" fill="none">
      <circle cx="20" cy="10" r="7" fill="rgba(201,169,110,0.35)" />
      <path d="M13 16 Q20 13 27 16" stroke="rgba(201,169,110,0.3)" stroke-width="1" fill="none" />
      <ellipse cx="20" cy="28" rx="8" ry="12" fill="rgba(201,169,110,0.25)" />
      <path d="M8 22 C2 18 0 25 5 28 C2 34 6 38 10 34" fill="rgba(201,169,110,0.25)" />
      <path d="M32 22 C38 18 40 25 35 28 C38 34 34 38 30 34" fill="rgba(201,169,110,0.25)" />
      <path d="M14 38 L13 48 M26 38 L27 48" stroke="rgba(201,169,110,0.3)" stroke-width="1.5" stroke-linecap="round" />
      <path d="M16 40 L12 46 M24 40 L28 46" stroke="rgba(201,169,110,0.3)" stroke-width="1" stroke-linecap="round" />
    </svg>
  </div>

  <!-- Butterfly/moth -->
  <div class="absolute" style="top:35%;right:22%;opacity:0.3;animation: drift 20s ease-in-out infinite reverse;">
    <svg width="32" height="28" viewBox="0 0 32 28" fill="none">
      <path d="M16 4 C10 0 2 2 2 10 C2 18 10 20 14 16" fill="rgba(201,169,110,0.2)" stroke="rgba(201,169,110,0.35)" stroke-width="0.5" />
      <path d="M16 4 C22 0 30 2 30 10 C30 18 22 20 18 16" fill="rgba(201,169,110,0.2)" stroke="rgba(201,169,110,0.35)" stroke-width="0.5" />
      <path d="M16 4 C12 8 12 16 15 22" fill="none" stroke="rgba(201,169,110,0.3)" stroke-width="0.5" />
      <path d="M16 4 C20 8 20 16 17 22" fill="none" stroke="rgba(201,169,110,0.3)" stroke-width="0.5" />
    </svg>
  </div>

  <!-- Another butterfly lower left -->
  <div class="absolute" style="top:70%;left:5%;opacity:0.25;transform:scale(0.8) rotate(20deg);animation: drift 26s ease-in-out 3s infinite;">
    <svg width="28" height="24" viewBox="0 0 28 24" fill="none">
      <path d="M14 3 C8 0 1 2 1 9 C1 16 8 18 12 14" fill="rgba(168,149,182,0.15)" stroke="rgba(168,149,182,0.3)" stroke-width="0.5" />
      <path d="M14 3 C20 0 27 2 27 9 C27 16 20 18 16 14" fill="rgba(168,149,182,0.15)" stroke="rgba(168,149,182,0.3)" stroke-width="0.5" />
      <line x1="14" y1="3" x2="14" y2="20" stroke="rgba(168,149,182,0.25)" stroke-width="0.5" />
    </svg>
  </div>

  <!-- Tiny cherub near bottom right -->
  <div class="absolute" style="top:82%;left:55%;opacity:0.3;transform:scale(0.5) rotate(-10deg);animation: drift 30s ease-in-out 6s infinite reverse;">
    <svg width="30" height="38" viewBox="0 0 30 38" fill="none">
      <circle cx="15" cy="7" r="5" fill="rgba(201,169,110,0.3)" />
      <ellipse cx="15" cy="20" rx="6" ry="9" fill="rgba(201,169,110,0.2)" />
      <path d="M8 15 C4 12 2 17 6 20" fill="rgba(201,169,110,0.2)" />
      <path d="M22 15 C26 12 28 17 24 20" fill="rgba(201,169,110,0.2)" />
      <circle cx="12.5" cy="6.5" r="0.8" fill="rgba(60,40,20,0.5)" />
      <circle cx="17.5" cy="6.5" r="0.8" fill="rgba(60,40,20,0.5)" />
      <path d="M13 8.5 Q15 9.5 17 8.5" stroke="rgba(201,169,110,0.3)" stroke-width="0.5" fill="none" />
    </svg>
  </div>

  <!-- Hanging stars on threads -->
  <div class="absolute" style="top:6%;left:18%;">
    <div class="absolute" style="left:0;top:-28;width:1;height:28;background:linear-gradient(to bottom,transparent,rgba(201,169,110,0.4));"></div>
    <div style="color:rgba(201,169,110,0.8);font-size:14px;text-shadow:0 0 8px rgba(201,169,110,0.3);">✦</div>
  </div>
  <div class="absolute" style="top:15%;left:65%;">
    <div class="absolute" style="left:0;top:-22;width:1;height:22;background:linear-gradient(to bottom,transparent,rgba(201,169,110,0.35));"></div>
    <div style="color:rgba(201,169,110,0.7);font-size:10px;text-shadow:0 0 6px rgba(201,169,110,0.25);">✦</div>
  </div>
  <div class="absolute" style="top:42%;left:3%;">
    <div class="absolute" style="left:0;top:-35;width:1;height:35;background:linear-gradient(to bottom,transparent,rgba(201,169,110,0.3));"></div>
    <div style="color:rgba(201,169,110,0.65);font-size:12px;text-shadow:0 0 7px rgba(201,169,110,0.2);">✦</div>
  </div>
  <div class="absolute" style="top:62%;left:85%;">
    <div class="absolute" style="left:0;top:-30;width:1;height:30;background:linear-gradient(to bottom,transparent,rgba(201,169,110,0.35));"></div>
    <div style="color:rgba(201,169,110,0.75);font-size:11px;text-shadow:0 0 6px rgba(201,169,110,0.25);">✦</div>
  </div>
</div>

