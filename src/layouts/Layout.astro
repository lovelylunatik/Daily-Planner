---
import '../styles/global.css';
import CelestialBackground from '../components/ui/CelestialBackground.astro';
import CelestialCompass from '../components/ui/CelestialCompass.astro';
import ThemeToggle from '../components/islands/ThemeToggle.tsx';
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>
    (function(){
      var s=localStorage.getItem('theme'),d=window.matchMedia('(prefers-color-scheme: dark)').matches;
      var t=s||(d?'dark':'light');
      document.documentElement.classList.toggle('dark',t==='dark');
      document.documentElement.classList.toggle('light',t==='light');
    })();
  </script>
</head>
<body class="bg-[var(--deep)] text-[var(--text-1)] antialiased vignette">
  <CelestialBackground />
  <CelestialCompass />
  <div class="fixed top-4 right-4 z-50">
    <ThemeToggle client:load />
  </div>
  <main class="md:pl-20 pt-1 pb-0 px-2 md:px-4 lg:px-6 relative z-10 min-h-screen">
    <slot />
  </main>
</body>
</html>