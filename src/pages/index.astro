---
import Layout from '../layouts/Layout.astro';
import ScrapbookPane from '../components/ui/ScrapbookPane.astro';
import RitualMini from '../components/islands/RitualMini';
import LivingClock from '../components/islands/LivingClock';
import JournalMini from '../components/islands/JournalMini';
import OracleMini from '../components/islands/OracleMini';
import MoodMini from '../components/islands/MoodMini';
---
<Layout title="The Oracle's Desk">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-[260px_1fr_1fr] gap-5 md:gap-6 auto-rows-min">
      <!-- Today / Calendar — Star Chart personality -->
      <a href="/week" class="contents">
        <ScrapbookPane title="Today" rotation={-1.2} className="row-span-1 relative" personality="star-chart">
          <span class="hanging-star" style="top:10px;right:12px;" />
          <div class="text-center py-2 relative">
            <div class="font-typewriter text-3xl text-[var(--gold)]">25</div>
            <div class="font-serif text-sm text-[var(--text-2)] italic mt-1">July</div>
            <div class="font-typewriter text-[10px] tracking-wider text-[var(--text-3)] mt-2">🌖 WANING GIBBOUS</div>
            <div class="font-typewriter text-[9px] text-[var(--gold)]/60 tracking-wider mt-3 uppercase">CLICK FOR FULL CHART</div>
            <span class="compass-star absolute top-0 right-0 text-sm opacity-40"></span>
          </div>
        </ScrapbookPane>
      </a>

      <!-- Daily Oracle — Tarot personality -->
      <ScrapbookPane title="Daily Oracle" rotation={0.8} className="md:col-span-2 relative" personality="tarot">
        <span class="hanging-star" style="top:12px;left:16px;" />
        <span class="hanging-star" style="top:8px;right:20px;" />
        <OracleMini client:load />
      </ScrapbookPane>

      <!-- Today's Rituals — Wax Seal personality -->
      <ScrapbookPane title="Today's Rituals" rotation={0.5} className="md:row-span-2" personality="wax-seal">
        <RitualMini client:load />
        <a href="/rituals" class="block mt-4 pt-3 border-t border-[var(--text-3)]/20 font-typewriter text-[10px] text-[var(--gold)]/60 tracking-wide text-center hover:text-[var(--gold)] transition-colors uppercase">
          View full altar
        </a>
      </ScrapbookPane>

      <!-- Grimoire / Journal — Parchment personality -->
      <ScrapbookPane title="Grimoire" rotation={-0.6} className="md:col-span-2" personality="parchment">
        <JournalMini client:load />
      </ScrapbookPane>

      <!-- The Hour — Sun Dial personality -->
      <div class="newspaper-overlay">
        <ScrapbookPane title="The Hour" rotation={1.0} personality="sundial">
          <LivingClock client:load />
        </ScrapbookPane>
      </div>

      <!-- Mood — Celestial personality -->
      <ScrapbookPane title="Mood" rotation={-0.8} personality="celestial">
        <MoodMini client:load />
      </ScrapbookPane>
    </div>
  </div>
</Layout>

