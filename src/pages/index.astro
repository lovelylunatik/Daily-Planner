---
import Layout from '../layouts/Layout.astro';
import ScrapbookPane from '../components/ui/ScrapbookPane.astro';
---
<Layout title="The Oracle's Desk">
  <div class="max-w-6xl mx-auto">
    <!-- Hub Grid — asymmetrical scrapbook collage -->
    <div class="grid grid-cols-1 md:grid-cols-[260px_1fr_1fr] gap-5 md:gap-6 auto-rows-min">
      <!-- Calendar mini -->
      <ScrapbookPane title="Today" rotation={-1.2} className="row-span-1">
        <div class="text-center py-2">
          <div class="font-typewriter text-3xl text-[var(--gold)]">24</div>
          <div class="font-serif text-sm text-[var(--text-2)] italic mt-1">July</div>
          <div class="font-typewriter text-[10px] tracking-wider text-[var(--text-3)] mt-2">🌙 WAXING GIBBOUS</div>
        </div>
      </ScrapbookPane>

      <!-- Oracle card -->
      <ScrapbookPane title="Daily Oracle" rotation={0.8} className="md:col-span-2">
        <blockquote class="font-serif text-lg italic text-[var(--text-1)] leading-relaxed border-l-2 border-[var(--gold-dim)] pl-4">
          "I told the stars about you."
        </blockquote>
        <p class="font-typewriter text-[10px] text-[var(--text-3)] mt-3 tracking-wide">— PULLED THIS MORNING</p>
      </ScrapbookPane>

      <!-- Rituals — tall left column -->
      <ScrapbookPane title="Today's Rituals" rotation={0.5} className="md:row-span-2">
        <div class="space-y-3">
          <div class="flex items-center gap-2 text-sm">
            <span class="w-4 h-4 rounded-full border border-[var(--gold)] flex items-center justify-center text-[8px] text-[var(--gold)]">✓</span>
            <span class="line-through text-[var(--text-3)]">Light morning candle</span>
          </div>
          <div class="flex items-center gap-2 text-sm">
            <span class="w-4 h-4 rounded-full border border-[var(--text-3)]"></span>
            <span>Doctor's appointment — 2:00 PM</span>
          </div>
          <div class="flex items-center gap-2 text-sm">
            <span class="w-4 h-4 rounded-full border border-[var(--text-3)]"></span>
            <span>Buy sage and lavender</span>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--text-3)]/20 font-typewriter text-[10px] text-[var(--text-3)] tracking-wide">
            1 OF 3 COMPLETE
          </div>
        </div>
      </ScrapbookPane>

      <!-- Journal prompt -->
      <ScrapbookPane title="Grimoire" rotation={-0.6} className="md:col-span-2">
        <p class="text-[var(--text-2)] italic text-sm leading-relaxed">
          "Record your thoughts, intentions, dreams..." The parchment waits.
        </p>
        <div class="mt-4 h-16 rounded border border-dashed border-[var(--text-3)]/30 flex items-center justify-center">
          <span class="font-typewriter text-[10px] text-[var(--text-3)] tracking-wider">TAP TO WRITE</span>
        </div>
      </ScrapbookPane>

      <!-- Clock -->
      <ScrapbookPane title="The Hour" rotation={1.0}>
        <div class="text-center">
          <div class="font-typewriter text-2xl text-[var(--gold)]">10:42</div>
          <div class="font-serif text-xs text-[var(--text-2)] italic mt-1">AM • Pacific</div>
        </div>
      </ScrapbookPane>

      <!-- Mood -->
      <ScrapbookPane title="Mood" rotation={-0.8}>
        <div class="flex items-center justify-center gap-3 py-1">
          <button class="text-xl opacity-40 hover:opacity-100 transition-opacity">🌙</button>
          <button class="text-xl opacity-60 hover:opacity-100 transition-opacity">☁️</button>
          <button class="text-xl opacity-100 scale-110 transition-transform">🌸</button>
          <button class="text-xl opacity-40 hover:opacity-100 transition-opacity">⚡</button>
        </div>
      </ScrapbookPane>
    </div>
  </div>
</Layout>